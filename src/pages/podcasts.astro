---
import Layout from "../layouts/Layout.astro";
import PodcastCard from "../components/PodcastCard.astro";

const perPage = 14;
const currentPage = 1;
const offset = 0;

const key = "sb_publishable_0kC09y0_QNUGVyZSy7xOWQ_itr3lxQ_";

const url = `https://gthqpnquordprfbbxrrc.supabase.co/rest/v1/episodes?select=*&order=release_date.desc&limit=${perPage}&offset=${offset}`;

const res = await fetch(url, {
  headers: {
    apikey: key,
    Authorization: `Bearer ${key}`,
    Prefer: "count=exact",
  },
});

const data = await res.json();

const contentRange = res.headers.get("content-range");
const totalItems = contentRange ? Number(contentRange.split("/")[1]) : data.length;
const totalPages = Math.ceil(totalItems / perPage);
---

<Layout>
  <!-- podcast intro -->
  <section class="podcasts-intro">
    <h2>Podcasts</h2>
    <p>Busy Being Well er et podcastunivers med fokus på velvære, trivsel og det moderne hverdagsliv. Gennem personlige fortællinger, ærlige refleksioner og samtaler med inspirerende mennesker udforskes alt fra sundhed og motivation til balance og de udfordringer, mange kan spejle sig i. Målet er ikke perfektion, men at skabe et autentisk rum med plads til inspiration, genkendelse og nye perspektiver.</p>
  </section>

  <!-- podcast grid -->
  <section class="podcast-grid">
    {
      data.map((episode, index) => (
        <!-- podcast grid item -->
        <div class="podcast-grid-item">
          <PodcastCard data={episode} index={index} priority={index < 3} />
        </div>
      ))
    }
  </section>

  <!-- pagination -->
  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Podcast sider">
        {Array.from({ length: totalPages }, (_, index) => {
          const page = index + 1;
          return (
            <a href={page === 1 ? "/podcasts" : `/podcasts/side/${page}`} class={page === currentPage ? "active" : ""}>
              {page}
            </a>
          );
        })}
      </nav>
    )
  }
</Layout>

<style>
  /* podcast intro */
  .podcasts-intro {
    margin-bottom: 3rem;
  }

  /* podcast intro tekst */
  .podcasts-intro p {
    max-width: 34rem;
  }

  /* podcast grid */
  .podcast-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 1rem;
  }

  /* desktop layout */
  @media (min-width: 900px) {
    .podcast-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 4rem 1.5rem;
    }

    .podcasts-intro p {
      max-width: 57rem;
    }

    .podcast-grid-item:nth-child(7n + 1) {
      grid-column: span 2;
    }

    .podcast-grid-item:nth-child(7n + 1) :global(.podcast-image) {
      aspect-ratio: auto;
      height: calc(((100vw - 3rem - (3 * 1.5rem)) / 4) * 1.25);
      object-position: center 25%;
    }
  }

  /* pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 5rem;
    margin-bottom: 4rem;
  }

  /* pagination links */
  .pagination a {
    font-family: "Unica", sans-serif;
    color: var(--black);
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  /* hover og aktiv pagination */
  .pagination a:hover,
  .pagination a.active {
    border-bottom-color: var(--black);
  }
</style>
