---
import ForsideLayout from "../layouts/ForsideLayout.astro";
import Footer from "../components/Footer.astro";
import PodcastsCard from "../components/PodcastCard.astro";
import Knap from "../components/Knap.astro";
import H2 from "../components/H2.astro";

const url = "https://ovfqkqxmthqfabnvnndq.supabase.co/rest/v1/byhaven?id=in.(1,2,3,4)&select=*";
const key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im92ZnFrcXhtdGhxZmFibnZubmRxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDY2OTQwNjAsImV4cCI6MjA2MjI3MDA2MH0.QGBHGl0rC79t_ySosixZ13L1Ukt5i3JvPwZaUEnMVvM";
---

<ForsideLayout>
  <section class="section ommig">
    <div class="image">
      <img src="ommig_billede1.png" alt="Cilia laver mad" />
    </div>

    <div class="text1">
      <div class="overskrifter">
        <h2 class="ommig">Mød Cilia Trappaud</h2>
        <h4>Stifter af BBW</h4>
      </div>

      <p>Busy Being Well er skabt af Cilia Trappaud som et personligt univers med fokus på velvære, refleksion og moderne hverdagsliv. Gennem podcasten inviteres du ind i ærlige samtaler, inspirerende perspektiver og historier, der giver plads til både nysgerrighed, nærvær og eftertanke.</p>
    </div>

    <div class="text2">
      <p>Her møder du mennesker, erfaringer og små indsigter, du kan tage med dig videre i din egen hverdag. Et univers der minder om, at velvære ser forskelligt ud for alle — og at der ikke findes én rigtig måde at have det godt på. Med plads til både det inspirerende, det ærlige og alt det midt imellem.</p>
    </div>
  </section>

  <section class="citat">
    <div class="citat-content">
      <h2>“Busy Being Well er en podcast og et univers dedikeret til at udforske veje til mere velvære. Et sted med inspiration, nysgerrighed og perspektiv. Vi dykker ned i de ting der betyder noget, for at have det godt i en moderne travl hverdag.”</h2>
    </div>

    <div class="knap-wrapper">
      <Knap text="LÆS MERE" href="/omos" variant="default" />
    </div>
  </section>

  <section class="podcast-section">
    <h2 class="podcast-heading">Podcasts</h2>

    <div class="podcast-content">
      <img src="podcast1.png" alt="podcast billede 1" />
      <img src="podcast2.png" alt="podcast billede 2" />
      <img src="podcast3.png" alt="podcast billede 3" />
    </div>

    <div class="podcast-knap-wrapper">
      <Knap text="SE ALLE PODCASTS" href="/podcasts" variant="default" />
    </div>
  </section>

  <section class="shop-section">
    <h2>Bliv en del af familien</h2>

    <div class="shop-content">
      <!-- Her kan dine API-cards komme ind senere -->
    </div>

    <div class="shop-knap-wrapper">
      <Knap text="GÅ TIL SHOP" href="/shop" variant="light" />
    </div>
  </section>

  <section class="instagram-section">
    <div class="instagram-header">
      <h2 class="instagram-heading">Gå til Instagram</h2>
    </div>

    <div class="instagram-layout">
      <p class="instagram-side-text">For inspiration, anbefalinger</p>

      <div class="instagram-content">
        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede1.png" alt="insta billede 1" />
          <span>Hvilke vitaminpiller tager jeg?</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede2.png" alt="insta billede 2" />
          <span>Min hudpleje rutine</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede3.png" alt="insta billede 3" />
          <span>Mit ugentlige indkøb</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede4.png" alt="insta billede 4" />
          <span>Opskrift på aftensmad</span>
        </a>
      </div>

      <p class="instagram-side-text">og mine velvære rutiner</p>
    </div>
  </section>
</ForsideLayout>

<style>
  .image img {
    width: 100%;
    height: auto;
  }

  /* om mig - mobil */
  .section.ommig {
    display: flex;
    flex-direction: column;
  }

  .text1 {
    order: 1;
    padding-top: 1rem;
    padding-right: 0;
    padding-bottom: 2rem;
    padding-left: 0;
  }

  .text1 .ommig {
    margin-bottom: 0;
  }

  .text2 {
    order: 3;
    padding-top: 1.5rem;
    padding-right: 0;
    padding-bottom: 2rem;
    padding-left: 0;
  }

  .ommig p {
    padding-bottom: 0;
  }

  .ommig .image {
    order: 2;
    width: auto;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }

  /* knap */
  .knap-wrapper {
    display: flex;
    justify-content: flex-end;
    margin-right: 0.4rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  /* citat - mobil */
  .citat {
    margin-top: 1rem;
    margin-bottom: 3rem;
    align-self: end;
  }

  .citat h2 {
    color: var(--citat);
    margin: 0 0 0 0.5rem;
    font-size: 1.5rem;
  }

  @media (min-width: 600px) {
    .ommig .image {
      margin-left: -2rem;
      margin-right: -2rem;
    }
  }

  @media (min-width: 900px) {
    /* om mig - desktop */
    .section.ommig {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: end;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .text1 {
      order: initial;
      grid-column: 2;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 0;
      padding-bottom: 0;
    }

    .text2 {
      order: initial;
      grid-column: 3;
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 0;
      padding-bottom: 0;
      margin-top: 0;
    }

    .ommig .image {
      order: initial;
      grid-column: 1;
      width: 100%;
      margin-left: -2rem;
      margin-right: 0;
    }

    /* knap - desktop */
    .knap-wrapper {
      display: block;
      grid-column: 3;
      justify-self: end;
      align-self: end;
      margin-bottom: 0.15rem;
      margin-right: 1.5rem;
    }

    /* citat - desktop */
    .citat {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      align-items: end;
      margin-top: 5rem;
      margin-bottom: 5rem;
    }

    .citat-content {
      grid-column: 1 / 3;
    }

    .citat h2 {
      margin: 0;
    }
  }

  /* podcast sectionen */
  .podcast-section {
    background-color: var(--cream_test);
    margin-top: 3rem;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding: 2rem 1rem;
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 2rem;
    overflow-x: hidden;
  }

  @media (min-width: 600px) {
    .podcast-section {
      margin-left: -2rem;
      margin-right: -2rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .podcast-heading {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--black);
    margin: 0;
    text-transform: uppercase;
    align-self: start;
  }

  .podcast-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 42rem;
  }

  .podcast-content img {
    width: 100%;
    height: 24rem;
    object-fit: cover;
    display: block;
  }

  .podcast-content img:first-child {
    object-position: center 18%;
  }

  .podcast-knap-wrapper {
    grid-column: 2;
    justify-self: end;
    align-self: start;
  }

  @media (min-width: 900px) {
    .podcast-content {
      grid-column: 2;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      max-width: none;
    }

    .podcast-content img:first-child {
      grid-column: span 2;
    }

    .podcast-knap-wrapper {
      grid-row: 2;
      margin-top: 2rem;
      margin-bottom: 6rem;
    }
  }

  /* shop sectionen */
  .shop-section {
    background-color: var(--burned_orange);
    min-height: 60rem;
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: start;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding: 4rem 1.5rem;
  }

  .shop-section h2 {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--cream);
    margin: 0;
    text-transform: uppercase;
    align-self: start;
  }

  .shop-content {
    min-height: 12rem;
  }

  .shop-knap-wrapper {
    grid-column: 2;
    justify-self: end;
    align-self: end;
    margin-top: 2rem;
  }

  @media (min-width: 600px) {
    .shop-section {
      margin-left: -2rem;
      margin-right: -2rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 900px) {
    .shop-section {
      column-gap: 2rem;
    }
  }

  /* instagram section */
  .instagram-section {
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }

  .instagram-header {
    padding-top: 2rem;
    padding-right: 1rem;
    padding-bottom: 1.5rem;
    padding-left: 1rem;
  }

  .instagram-heading {
    color: var(--black);
    margin: 0;
  }

  .instagram-layout {
    display: block;
  }

  .instagram-side-text {
    display: none;
  }

  .instagram-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .instagram-card {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .instagram-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    filter: brightness(87%);
    transition: filter 0.3s ease;
  }

  .instagram-card span {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    color: var(--white);
    font-family: "Unica", sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    z-index: 2;
    pointer-events: none;
  }

  .instagram-card:hover img {
    filter: brightness(100%);
  }

  @media (min-width: 600px) {
    .instagram-section {
      margin-left: -2rem;
      margin-right: -2rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 900px) {
    .instagram-section {
      padding-top: 2rem;
      padding-bottom: 6rem;
    }

    .instagram-header {
      padding-left: 0;
      padding-right: 0;
    }

    .instagram-layout {
      display: grid;
      grid-template-columns: 1fr minmax(28rem, 34rem) 1fr;
      align-items: center;
      gap: 3rem;
    }

    .instagram-content {
      grid-column: 2;
      max-width: 34rem;
      margin-left: auto;
      margin-right: auto;
    }

    .instagram-side-text {
      display: block;
      color: var(--citat);
      margin: 0;
      padding-bottom: 0;
      align-self: center;
    }

    .instagram-side-text:first-child {
      justify-self: start;
    }

    .instagram-side-text:last-child {
      justify-self: end;
    }

    .instagram-card span {
      font-size: 0.7rem;
    }
  }
</style>
