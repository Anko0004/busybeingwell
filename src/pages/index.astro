---
import ForsideLayout from "../layouts/ForsideLayout.astro";
import PodcastCard from "../components/PodcastCard.astro";
import ShopCard from "../components/ShopCard.astro";
import Knap from "../components/Knap.astro";
import NewsletterPopup from "../components/NewsletterPopup.astro";

const key = "sb_publishable_0kC09y0_QNUGVyZSy7xOWQ_itr3lxQ_";

const options = {
  headers: {
    apikey: key,
    Authorization: `Bearer ${key}`,
  },
};

const podcastUrl = "https://gthqpnquordprfbbxrrc.supabase.co/rest/v1/episodes?select=*&order=release_date.desc&limit=3";
const shopUrl = "https://gthqpnquordprfbbxrrc.supabase.co/rest/v1/ShopCard?select=*&order=id.asc&limit=4";

const [podcastRes, shopRes] = await Promise.all([fetch(podcastUrl, options), fetch(shopUrl, options)]);

const podcasts = await podcastRes.json();
const products = await shopRes.json();
---

<ForsideLayout>
  <NewsletterPopup />
  <section class="intro-screen snap-section">
    <div class="section ommig">
      <div class="image">
        <img src="cilia_ommig1.webp" alt="Cilia laver mad" />
      </div>

      <div class="text1">
        <div class="overskrifter">
          <h2 class="ommig">Mød Cilia Trappaud</h2>
          <h4>Stifter af BBW</h4>
        </div>

        <p>Mit navn er Cilia Trappaud, jeg er født og opvokset i København. Som barn forelskede jeg mig i dans og musik, og det blev definerende for min barndom, ungdom og mit liv som ung voksen. Jeg kan ikke huske mit liv uden dans, og jeg har brugt utallige timer på at dygtiggøre mig indenfor faget. Jeg klarede mig fint i skolen, og havde en interesse for og idé om, at læse journalistik, retorik eller psykologi - men endte med at</p>
      </div>

      <div class="text2">
        <p>følge mit hjerte og satse på dansen. Jeg har lidt svært ved at gøre noget halvt, og kan godt lide udfordringer, så jeg valgte i en alder af 25 år at flytte til Los Angeles, Hollywood for at følge mine største dansedrømme. Tilpas naivt, skræmmende og spændende. De sidste 8 år har jeg arbejdet fuld tid som professionel danser på top-plan med alt hvad det indebærer: træning, pres, performance, udfordringer og drømme der gik.</p>
      </div>
    </div>

    <div class="citat">
      <div class="citat-content">
        <h2>“Hvis man endelig skal være busy med noget, så er det med fokus på at være well — for vi prøver alle at finde balancen mellem en travl virkelighed og ønsket om samtidig at passe bedre på os selv"</h2>
      </div>

      <div class="knap-wrapper">
        <Knap text="LÆS MERE" href="/ommig" variant="default" />
      </div>
    </div>
  </section>

  <section class="podcast-section snap-section">
    <h2 class="podcast-heading">Podcasts</h2>

    <div class="podcast-content">
      {
        podcasts.map((podcast, index) => (
          <div class={index === 0 ? "podcast-card-wrapper featured-podcast" : "podcast-card-wrapper"}>
            <PodcastCard data={podcast} index={index} />
          </div>
        ))
      }
    </div>

    <div class="podcast-knap-wrapper section-knap">
      <Knap text="SE ALLE PODCASTS" href="/podcasts" variant="default" />
    </div>
  </section>

  <section class="shop-section snap-section">
    <h2>Shop</h2>

    <div class="shop-content">
      {
        products.map((product) => (
          <div class="shop-card-wrapper">
            <ShopCard data={product} />
          </div>
        ))
      }
    </div>

    <div class="shop-knap-wrapper">
      <Knap text="GÅ TIL SHOP" href="/shop" variant="light" />
    </div>
  </section>

  <section class="instagram-section snap-section">
    <div class="instagram-header">
      <h2 class="instagram-heading">Følg med på Instagram</h2>
    </div>

    <div class="instagram-layout">
      <p class="instagram-side-text">For inspiration, personlige anbefalinger</p>

      <div class="instagram-content">
        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede1.webp" alt="insta billede 1" />
          <span>Hvad er der i min indkøbskurv?</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede4.webp" alt="insta billede 2" />
          <span>Hvad 8 år i LA har lært mig</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede3.webp" alt="insta billede 3" />
          <span>Min skincare rutine</span>
        </a>

        <a class="instagram-card" href="https://www.instagram.com/" target="_blank">
          <img src="insta_billede2.webp" alt="insta billede 4" />
          <span>Mine go-to helsebutikker</span>
        </a>
      </div>

      <p class="instagram-side-text">og mine velvære rutiner</p>
    </div>
  </section>
</ForsideLayout>

<style>
  :root {
    --section-top: 5rem;
    --section-bottom: 5rem;
    --section-gap: 5rem;
  }

  /* Global / Shared */

  .image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .knap-wrapper,
  .section-knap {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }

  .podcast-section,
  .shop-section {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 2rem;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding: 5rem 1rem var(--section-bottom);
  }

  .podcast-heading,
  .shop-section h2 {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin: 0;
    text-transform: uppercase;
    align-self: start;
  }

  .podcast-knap-wrapper,
  .shop-knap-wrapper {
    grid-column: 2;
    justify-self: end;
    align-self: end;
  }

  .shop-knap-wrapper {
    margin-top: 1.5rem;
  }

  /* Intro */

  .intro-screen {
    padding-bottom: var(--section-bottom);
  }

  .section.ommig {
    display: flex;
    flex-direction: column;
  }

  .text1 {
    order: 1;
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  .text1 .ommig {
    margin-bottom: 0;
  }

  .text2 {
    order: 3;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .ommig p {
    padding-bottom: 0;
  }

  .ommig .image {
    order: 2;
    width: auto;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }

  .ommig .image img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
  }

  .citat {
    margin-top: 1rem;
  }

  .citat h2 {
    color: var(--citat);
    margin: 0 0 0 0.5rem;
    font-size: 1.5rem;
  }

  /* Podcasts */

  .podcast-section {
    background-color: var(--cream_test);
    overflow-x: hidden;
  }

  .podcast-heading {
    color: var(--black);
  }

  .podcast-content {
    display: grid;
    grid-column: 2;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 42rem;
  }

  .podcast-content img {
    width: 100%;
    height: 24rem;
    object-fit: cover;
    display: block;
  }

  .podcast-content img:first-child {
    object-position: center 18%;
  }

  /* Shop */

  .shop-section {
    background-color: var(--burned_orange);
  }

  .shop-section h2 {
    color: var(--cream);
  }

  .shop-content {
    display: grid;
    grid-column: 2;
    grid-template-columns: 1fr;
    gap: 2rem;
    min-height: 12rem;
  }

  .shop-card-wrapper {
    width: 100%;
  }

  /* Instagram */

  .instagram-section {
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }

  .instagram-header {
    padding: 2rem 1rem 1.5rem;
  }

  .instagram-heading {
    color: var(--black);
    margin: 0;
  }

  .instagram-layout {
    display: block;
  }

  .instagram-side-text {
    display: none;
  }

  .instagram-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .instagram-card {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .instagram-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    filter: brightness(87%);
    transition: filter 0.3s ease;
  }

  .instagram-card span {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    color: var(--white);
    font-family: "Unica", sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    z-index: 2;
    pointer-events: none;
  }

  .instagram-card:hover img {
    filter: brightness(100%);
  }

  /* Tablet */

  @media (min-width: 600px) {
    /* Intro tablet */

    .ommig .image {
      margin-left: -2rem;
      margin-right: -2rem;
    }

    /* Global / Shared tablet */

    .podcast-section,
    .shop-section,
    .instagram-section {
      margin-left: -2rem;
      margin-right: -2rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  /* Intro desktop */

  @media (min-width: 900px) {
    .intro-screen {
      min-height: 100svh;
      box-sizing: border-box;
      display: grid;
      grid-template-rows: auto auto;
      align-content: space-between;
      padding-top: var(--section-top);
      padding-bottom: var(--section-bottom);
    }

    .section.ommig {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: stretch;
      gap: 2rem;
      margin-bottom: 0;
    }

    .text1 {
      order: initial;
      grid-column: 2;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-self: stretch;
      padding: 0 1rem;
    }

    .text2 {
      order: initial;
      grid-column: 3;
      display: flex;
      align-items: flex-end;
      align-self: stretch;
      padding: 0 1rem;
      margin-top: 0;
    }

    .ommig .image {
      order: initial;
      grid-column: 1;
      margin-left: -2rem;
      margin-right: 0;
    }

    .citat {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      align-items: end;
      margin-top: var(--section-gap);
    }

    .citat-content {
      grid-column: 1 / 3;
    }

    .citat h2 {
      margin: 0;
    }

    .knap-wrapper {
      display: block;
      grid-column: 3;
      justify-self: end;
      align-self: end;
      margin-top: 0;
    }

    /* Podcasts desktop */

    .podcast-section {
      min-height: 100svh;
      box-sizing: border-box;
      grid-template-rows: auto auto;
      align-content: space-between;
      padding-top: var(--section-top);
      padding-bottom: var(--section-bottom);
    }

    .podcast-content {
      --podcast-gap: 1.5rem;
      container-type: inline-size;
      grid-column: 2;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--podcast-gap);
      max-width: none;
    }

    .featured-podcast {
      grid-column: span 2;
    }

    .featured-podcast :global(.podcast-image) {
      aspect-ratio: auto;
      height: calc(((100cqw - (3 * var(--podcast-gap))) / 4) * 1.25);
      object-fit: cover;
      object-position: center 18%;
    }

    /* Shop desktop */

    .shop-section {
      box-sizing: border-box;
      grid-template-rows: auto auto;
      align-content: space-between;
      padding-top: var(--section-top);
      padding-bottom: var(--section-bottom);
    }

    .shop-content {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: end;
      justify-self: center;
      width: 100%;
      gap: 4rem;
    }

    /* Buttons desktop */

    .section-knap {
      display: block;
      margin-top: var(--section-gap);
    }

    /* Instagram desktop */

    .instagram-section {
      min-height: 100svh;
      box-sizing: border-box;
      padding-top: var(--section-top);
      padding-bottom: 6rem;
    }

    .instagram-header {
      padding: 0 0 1.5rem;
    }

    .instagram-layout {
      display: grid;
      grid-template-columns: 1fr minmax(28rem, 34rem) 1fr;
      align-items: center;
      gap: 3rem;
    }

    .instagram-content {
      grid-column: 2;
      max-width: 34rem;
      margin-left: auto;
      margin-right: auto;
    }

    .instagram-side-text {
      display: block;
      color: var(--citat);
      margin: 0;
      padding-bottom: 0;
      align-self: center;
    }

    .instagram-side-text:first-child {
      justify-self: start;
    }

    .instagram-side-text:last-child {
      justify-self: end;
    }

    .instagram-card span {
      font-size: 0.7rem;
    }
  }
</style>
