---
const { variant = "default" } = Astro.props;
---

<footer class={`footer ${variant === "orange" ? "footer-orange" : ""}`}>
  <div class="footer-inner">
    <!-- Logo -->
    <a class="footer-logo" href="/">busy being well</a>

    <!-- Footer indhold -->
    <div class="footer-grid">
      <div class="footer-box about">
        <h3>OM OS</h3>
        <p>Busy Being Well er et roligt univers med podcasts, refleksioner og inspiration til mere nærvær, velvære og balance i hverdagen</p>
      </div>

      <div class="footer-box follow">
        <h3>FØLG MED</h3>
        <a href="https://www.instagram.com/busybeingwelll/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.tiktok.com/@busybeingwelll" target="_blank" rel="noopener noreferrer">TikTok</a>
        <a href="https://open.spotify.com/show/5r1ec3iXWGTemUGaLslGfo" target="_blank" rel="noopener noreferrer">Spotify</a>
      </div>

      <div class="footer-box contact">
        <h3>KONTAKT</h3>
        <p>Busy Being Well</p>
        <a class="contact-email" href="mailto:hello@busybeingwell.com">hello@busybeingwell.com</a>
        <p>København, Danmark</p>
      </div>

      <!-- Nyhedsbrev -->
      <div class="footer-box newsletter">
        <h3>TILMELD DIG VORES NYHEDSBREV</h3>
        <p class="newsletter-text">Modtag nye episoder, udvalgte fortællinger og inspiration direkte i din indbakke</p>

        <form class="newsletter-form" id="footerNewsletterForm">
          <label for="email" class="sr-only">E-mail</label>
          <input id="email" type="email" placeholder="Skriv din e-mail her" />
          <button type="submit">Tilmeld</button>
        </form>

        <p class="newsletter-note">Ved tilmelding accepterer du vores privatlivspolitik</p>
      </div>
    </div>

    <!-- Nederste linje -->
    <div class="footer-bottom">
      <p>© 2026 Busy Being Well</p>

      <div class="footer-legal">
        <a href="/privatlivspolitik">Privatlivspolitik</a>
        <span>·</span>
        <a href="/cookiepolitik">Cookiepolitik</a>
      </div>

      <p class="credits">Website udviklet af <span>Sofie Utke & Anna Pri</span></p>
    </div>
  </div>
</footer>

<style>
  /* Footer base */
  .footer {
    background-color: var(--lysere_cream);
    padding: 4rem 1.5rem 2rem;
  }

  /* Orange footer variant */
  .footer-orange {
    background-color: var(--burned_orange);
  }

  .footer-orange .footer-logo,
  .footer-orange .footer-box h3,
  .footer-orange .footer-box p,
  .footer-orange .footer-box a,
  .footer-orange .footer-bottom p,
  .footer-orange .footer-bottom a,
  .footer-orange .footer-bottom span,
  .footer-orange .newsletter-form input,
  .footer-orange .newsletter-form button {
    color: var(--cream);
  }

  .footer-orange .newsletter-form input,
  .footer-orange .newsletter-form button {
    border-color: var(--cream);
  }

  .footer-orange .newsletter-form input::placeholder {
    color: var(--cream);
  }

  .footer-orange .newsletter-form button:hover {
    background-color: var(--cream);
    color: var(--burned_orange);
  }

  /* Mobil layout */
  .footer-inner {
    display: flex;
    flex-direction: column;
    margin-left: 1rem;
    margin-right: 1rem;
  }

  .footer-logo {
    order: 1;
    display: block;
    width: fit-content;
    margin: 0 auto 3rem;
    font-family: "Serious Sans", sans-serif;
    color: var(--black);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
  }

  .footer-grid {
    order: 2;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    column-gap: 4rem;
    row-gap: 3rem;
  }

  /* Tekst */
  .footer-box h3 {
    margin: 0 0 0.35rem;
    font-family: "Unica", sans-serif;
    color: var(--citat);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.1rem;
  }

  .footer-box p,
  .footer-box a {
    display: block;
    margin: 0;
    padding: 0;
    font-family: "Unica", sans-serif;
    color: var(--citat);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.15rem;
    text-decoration: none;
  }

  /* Mobil placering */
  .about {
    grid-column: 1;
  }

  .follow {
    grid-column: 2;
    align-items: end;
  }

  .contact,
  .newsletter {
    grid-column: 1 / -1;
  }

  .footer-box .contact-email {
    font-weight: 500;
  }

  /* Nyhedsbrev form */
  .newsletter-form {
    display: flex;
    align-items: stretch;
    max-width: 22rem;
    margin-top: 1rem;
  }

  .newsletter-form input {
    width: 100%;
    height: 2rem;
    border: 1px solid var(--footer);
    border-right: 0;
    background-color: transparent;
    padding: 0 0.75rem;
    font-family: "Unica", sans-serif;
    color: var(--black);
    font-size: 0.75rem;
  }

  .newsletter-form input::placeholder {
    color: var(--citat);
  }

  .newsletter-form button {
    height: 2rem;
    border: 1px solid var(--footer);
    background-color: transparent;
    padding: 0 0.8rem;
    font-family: "Unica", sans-serif;
    color: var(--citat);
    font-size: 0.75rem;
    font-weight: 300;
    cursor: pointer;
    margin-bottom: 0.2rem;
  }

  .newsletter-form button:hover {
    background-color: var(--footer);
    color: var(--black);
  }

  .newsletter-text {
    max-width: 26rem;
  }

  .footer-box .newsletter-note {
    font-size: 0.7rem;
  }

  /* "Sendt" */
  .newsletter-form input:disabled {
    color: var(--citat);
    opacity: 1;
    cursor: default;
  }

  .newsletter-form input:disabled::placeholder {
    color: var(--citat);
  }

  /* Nederste footer */
  .footer-bottom {
    order: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
    row-gap: 0.35rem;
    margin-top: 4rem;
    align-items: end;
  }

  .footer-bottom > p:first-child {
    grid-column: 1;
    grid-row: 1;
  }

  .footer-bottom p,
  .footer-bottom a,
  .footer-bottom span {
    margin: 0;
    padding: 0;
    font-family: "Unica", sans-serif;
    color: var(--citat);
    font-size: 0.7rem;
    line-height: 1rem;
    text-decoration: none;
  }

  .footer-legal {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    gap: 0.85rem;
  }

  .footer-legal a:hover {
    text-decoration: underline;
    opacity: 0.85;
  }

  .credits {
    grid-column: 2;
    grid-row: 1 / 3;
    justify-self: end;
    align-self: end;
    text-align: right;
    max-width: 7rem;
  }

  .credits span {
    font-weight: 400;
  }

  /* Screenreader label */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  /* Desktop layout */
  @media (min-width: 900px) {
    .footer {
      padding: 4rem 2rem 2.5rem;
    }

    .footer-inner {
      display: grid;
      grid-template-columns: 1.8fr 1fr 0.8fr 1fr;
      column-gap: 5.5rem;
      align-items: start;
    }

    .footer-logo {
      grid-column: 1;
      grid-row: 2;
      margin: 2.5rem 0 0;
    }

    .footer-grid {
      display: contents;
    }

    .newsletter {
      grid-column: 1;
      grid-row: 1;
    }

    .about {
      grid-column: 2;
      grid-row: 1;
    }

    .about p {
      max-width: 16rem;
    }

    .follow {
      grid-column: 3;
      grid-row: 1;
      margin-left: 2.5rem;
    }

    .contact {
      grid-column: 4;
      grid-row: 1;
    }

    .footer-bottom {
      grid-column: 1 / 5;
      grid-row: 2;
      display: grid;
      grid-template-columns: 1.8fr 1fr 0.8fr 1fr;
      column-gap: 5.5rem;
      align-self: end;
      align-items: start;
      margin-top: 2.5rem;
    }

    .footer-bottom > p:first-child {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
    }

    .footer-legal {
      grid-column: 3;
      grid-row: 1;
      justify-self: start;
      margin-left: clamp(-10rem, -9vw, -3rem);
    }

    .credits {
      grid-column: 4;
      grid-row: 1;
      justify-self: start;
      text-align: left;
      max-width: none;
    }
  }
</style>

<script>
  /* Nyhedsbrev: skift input til "Sendt" */
  const footerNewsletterForm = document.getElementById("footerNewsletterForm");
  const footerNewsletterInput = document.getElementById("email");
  const footerNewsletterButton = footerNewsletterForm?.querySelector("button");

  footerNewsletterForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (footerNewsletterInput) {
      footerNewsletterInput.value = "";
      footerNewsletterInput.placeholder = "Sendt";
      footerNewsletterInput.disabled = true;
      footerNewsletterInput.style.borderRight = "1px solid var(--footer)";
    }

    if (footerNewsletterButton) {
      footerNewsletterButton.style.display = "none";
    }
  });
</script>
