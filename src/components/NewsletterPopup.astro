<div class="newsletter-popup" id="newsletterPopup">
  <div class="newsletter-popup-card">
    <button class="newsletter-popup-close" type="button" aria-label="Luk popup"> × </button>

    <div class="newsletter-popup-content">
      <div class="newsletter-signup" id="newsletterSignup">
        <h2>Join Busy Being Well universet</h2>

        <p>Vær den første til at modtage nye episoder, anbefalinger og ærlige tanker om velvære, hverdagsliv og alt det indimellem.</p>

        <p>Skriv dig op til vores nyhedsbrev.</p>

        <form class="newsletter-form" id="newsletterForm">
          <label for="popup-email" class="sr-only">E-mail</label>
          <input id="popup-email" type="email" placeholder="Skriv din e-mail her" required />
          <button type="submit">Tilmeld</button>
        </form>
      </div>

      <div class="newsletter-success" id="newsletterSuccess" aria-live="polite">
        <h2>Velkommen til familien!</h2>
      </div>

      <p class="newsletter-note">Ved tilmelding accepterer du at modtage nyhedsbreve via e-mail. Afmeld når som helst. Læs vores privatlivspolitik.</p>
    </div>

    <div class="newsletter-popup-image">
      <img src="/cilia9.webp" alt="Cilia fra Busy Being Well" />
    </div>
  </div>
</div>

<style>
  .newsletter-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    pointer-events: none;
  }

  .newsletter-popup.is-hidden {
    display: none;
  }

  .newsletter-popup-card {
    position: relative;
    width: min(100%, 28.5rem);
    max-height: calc(100svh - 3rem);
    background: var(--white);
    display: grid;
    grid-template-columns: 1fr;
    overflow-y: auto;
    pointer-events: auto;
  }

  .newsletter-popup-content {
    padding: 3rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .newsletter-popup-content h2 {
    max-width: 23rem;
    margin: 0 0 1.4rem;
    font-family: "Playfair Display SC", serif;
    font-size: 1.9rem;
    line-height: 1.25;
    font-weight: 210;
    text-transform: uppercase;
    color: var(--black);
  }

  .newsletter-popup-content p {
    max-width: 23rem;
    margin: 0 0 1.6rem;
    padding-bottom: 0;
    font-family: "Unica", sans-serif;
    font-size: 0.78rem;
    line-height: 1.35;
    font-weight: 300;
    color: var(--black);
  }

  .newsletter-popup .newsletter-form {
    width: 100%;
    display: flex;
    align-items: stretch;
    margin-top: -0.4rem;
    margin-bottom: 2rem;
  }

  .newsletter-popup .newsletter-form label,
  .newsletter-popup .newsletter-form .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .newsletter-popup .newsletter-form input {
    flex: 1;
    min-width: 0;
    height: 3.1rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-right: 0;
    padding: 0 1rem;
    background: var(--white);
    color: var(--black);
    font-family: "Unica", sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
  }

  .newsletter-popup .newsletter-form input::placeholder {
    color: var(--citat);
  }

  .newsletter-popup .newsletter-form button {
    flex: 0 0 6.5rem;
    height: 3.1rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: var(--white);
    color: var(--citat);
    font-family: "Unica", sans-serif;
    font-size: 0.8rem;
    font-weight: 300;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .newsletter-popup .newsletter-form button:hover {
    background: var(--white);
    border-color: var(--citat);
    color: var(--citat);
  }

  .newsletter-popup .newsletter-note {
    margin: 0;
    color: var(--citat);
  }

  .newsletter-popup-image {
    min-height: 28rem;
  }

  .newsletter-popup-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .newsletter-popup-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 3;
    border: 0;
    background: transparent;
    color: var(--black);
    font-family: "Unica", sans-serif;
    font-size: 2rem;
    line-height: 1;
    font-weight: 300;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .newsletter-popup-close:hover {
    color: var(--citat);
  }

  /* Tak skærm */
  .newsletter-signup.is-hidden {
    display: none;
  }

  .newsletter-success {
    display: none;
  }

  .newsletter-success.is-visible {
    display: block;
  }

  .newsletter-success h2 {
    max-width: 16rem;
  }
  /* Tak skærm */

  @media (min-width: 700px) {
    .newsletter-popup {
      padding: 3rem;
    }

    .newsletter-popup-card {
      width: min(720px, calc(100vw - 4rem));
      min-height: 400px;
      max-height: none;
      grid-template-columns: 1fr 1fr;
      overflow: visible;
    }

    .newsletter-popup-content {
      padding: 4.8rem 1.5rem 1rem;
    }

    .newsletter-popup-content h2 {
      max-width: 22rem;
      margin-bottom: 1.1rem;
      font-size: 1.45rem;
    }

    .newsletter-popup-content p {
      max-width: 22rem;
      margin-bottom: 2rem;
      font-size: 0.72rem;
      line-height: 1.3;
    }

    .newsletter-popup .newsletter-form {
      max-width: 22rem;
      margin-top: -0.3rem;
      margin-bottom: 0;
    }

    .newsletter-popup .newsletter-form input,
    .newsletter-popup .newsletter-form button {
      height: 2.6rem;
      font-size: 0.72rem;
    }

    .newsletter-popup .newsletter-form button {
      flex-basis: 5rem;
    }

    .newsletter-popup .newsletter-note {
      margin-top: auto;
    }

    .newsletter-popup-image {
      min-height: 400px;
    }

    .newsletter-popup-close {
      color: var(--white);
    }

    .newsletter-popup-close:hover {
      color: var(--citat);
    }

    /* Tak skærm */
    .newsletter-success h2 {
      max-width: 17rem;
      font-size: 2rem;
      line-height: 1.3;
    }
    /* Tak skærm */
  }
</style>

<script>
  const popup = document.getElementById("newsletterPopup");
  const closeButton = document.querySelector(".newsletter-popup-close");
  const form = document.getElementById("newsletterForm");
  const signup = document.getElementById("newsletterSignup");
  const success = document.getElementById("newsletterSuccess");

  closeButton?.addEventListener("click", () => {
    popup?.classList.add("is-hidden");
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    signup?.classList.add("is-hidden");
    success?.classList.add("is-visible");
  });
</script>

