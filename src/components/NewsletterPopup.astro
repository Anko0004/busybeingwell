<!-- newsletter popup -->
<div class="newsletter-popup is-hidden" id="newsletterPopup">
  <!-- popup kort -->
  <div class="newsletter-popup-card">
    <!-- luk knap -->
    <button class="newsletter-popup-close" type="button" aria-label="Luk popup"> × </button>

    <!-- popup tekstindhold -->
    <div class="newsletter-popup-content">
      <!-- tilmelding -->
      <div class="newsletter-signup" id="newsletterSignup">
        <h2>Bliv en del af Busy Being Well universet</h2>

        <p>Vær den første til at modtage nye episoder, personlige anbefalinger og ærlige tanker om velvære, hverdagsrutiner og alt det indimellem.</p>

        <p>Skriv dig op til vores nyhedsbrev.</p>

        <!-- newsletter formular -->
        <form class="newsletter-form" id="newsletterForm">
          <label for="popup-email" class="sr-only">E-mail</label>
          <input id="popup-email" type="email" placeholder="Skriv din e-mail her" required />
          <button type="submit">Tilmeld</button>
        </form>
      </div>

      <!-- tak skærm -->
      <div class="newsletter-success" id="newsletterSuccess" aria-live="polite">
        <h2>Velkommen til familien!</h2>
      </div>

      <!-- privatlivstekst -->
      <p class="newsletter-note">
        Ved tilmelding accepterer du at modtage nyhedsbreve via e-mail. Afmeld når som helst. Læs vores
        <a href="/privatlivspolitik">privatlivspolitik</a>.
      </p>
    </div>

    <!-- popup billede -->
    <div class="newsletter-popup-image">
      <img src="/cilia9.webp" alt="Cilia fra Busy Being Well" />
    </div>
  </div>
</div>

<style>
  /* newsletter popup */
  .newsletter-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    pointer-events: none;
  }

  /* skjuler newsletter popup */
  .newsletter-popup.is-hidden {
    display: none;
  }

  /* popup kort */
  .newsletter-popup-card {
    position: relative;
    width: min(100%, 25rem);
    max-height: calc(100svh - 2rem);
    background: var(--white);
    display: grid;
    grid-template-columns: 1fr;
    overflow-y: auto;
    pointer-events: auto;
  }

  /* popup tekstindhold */
  .newsletter-popup-content {
    padding: 2.4rem 1.2rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  /* popup overskrift */
  .newsletter-popup-content h2 {
    max-width: 20rem;
    margin: 0 0 1rem;
    font-family: "Playfair Display SC", serif;
    font-size: 1.45rem;
    line-height: 1.2;
    font-weight: 210;
    text-transform: uppercase;
    color: var(--black);
  }

  /* popup brødtekst */
  .newsletter-popup-content p {
    max-width: 20rem;
    margin: 0 0 1.2rem;
    padding-bottom: 0;
    font-family: "Unica", sans-serif;
    font-size: 0.72rem;
    line-height: 1.3;
    font-weight: 300;
    color: var(--black);
  }

  /* newsletter formular */
  .newsletter-popup .newsletter-form {
    width: 100%;
    display: flex;
    align-items: stretch;
    margin-top: -0.2rem;
    margin-bottom: 1.4rem;
  }

  /* skjult label til accessibility */
  .newsletter-popup .newsletter-form label,
  .newsletter-popup .newsletter-form .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* email input */
  .newsletter-popup .newsletter-form input {
    flex: 1;
    min-width: 0;
    height: 2.55rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-right: 0;
    padding: 0 0.8rem;
    background: var(--white);
    color: var(--black);
    font-family: "Unica", sans-serif;
    font-size: 0.72rem;
    font-weight: 300;
  }

  /* placeholder tekst */
  .newsletter-popup .newsletter-form input::placeholder {
    color: var(--citat);
  }

  /* tilmeld knap */
  .newsletter-popup .newsletter-form button {
    flex: 0 0 5rem;
    height: 2.55rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: var(--white);
    color: var(--citat);
    font-family: "Unica", sans-serif;
    font-size: 0.72rem;
    font-weight: 300;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  /* hover på tilmeld knap */
  .newsletter-popup .newsletter-form button:hover {
    background: var(--white);
    border-color: var(--citat);
    color: var(--citat);
  }

  /* note tekst */
  .newsletter-popup .newsletter-note {
    margin: 0;
    color: var(--citat);
  }

  /* link i note tekst */
  .newsletter-popup .newsletter-note a {
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.08em;
  }

  /* hover på note link */
  .newsletter-popup .newsletter-note a:hover {
    opacity: 0.85;
  }

  /* popup billede */
  .newsletter-popup-image {
    min-height: 18rem;
  }

  /* billede styling */
  .newsletter-popup-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* luk knap */
  .newsletter-popup-close {
    position: absolute;
    top: 0.55rem;
    right: 0.65rem;
    z-index: 3;
    border: 0;
    background: transparent;
    color: var(--black);
    font-family: "Unica", sans-serif;
    font-size: 1.6rem;
    line-height: 1;
    font-weight: 300;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  /* hover på luk knap */
  .newsletter-popup-close:hover {
    color: var(--citat);
  }

  /* Tak skærm */
  .newsletter-signup.is-hidden {
    display: none;
  }

  .newsletter-success {
    display: none;
  }

  .newsletter-success.is-visible {
    display: block;
  }

  .newsletter-success h2 {
    max-width: 16rem;
  }
  /* Tak skærm */

  /* desktop popup */
  @media (min-width: 700px) {
    .newsletter-popup {
      padding: 3rem;
    }

    .newsletter-popup-card {
      width: min(720px, calc(100vw - 4rem));
      min-height: 400px;
      max-height: none;
      grid-template-columns: 1fr 1fr;
      overflow: visible;
    }

    .newsletter-popup-content {
      padding: 4.8rem 1.5rem 1rem;
    }

    .newsletter-popup-content h2 {
      max-width: 22rem;
      margin-bottom: 1.1rem;
      font-size: 1.45rem;
    }

    .newsletter-popup-content p {
      max-width: 22rem;
      margin-bottom: 2rem;
      font-size: 0.72rem;
      line-height: 1.3;
    }

    .newsletter-popup .newsletter-form {
      max-width: 22rem;
      margin-top: -0.3rem;
      margin-bottom: 0;
    }

    .newsletter-popup .newsletter-form input,
    .newsletter-popup .newsletter-form button {
      height: 2.6rem;
      font-size: 0.72rem;
    }

    .newsletter-popup .newsletter-form button {
      flex-basis: 5rem;
    }

    .newsletter-popup .newsletter-note {
      margin-top: auto;
    }

    .newsletter-popup-image {
      min-height: 400px;
    }

    .newsletter-popup-close {
      color: var(--white);
    }

    .newsletter-popup-close:hover {
      color: var(--citat);
    }

    /* Tak skærm */
    .newsletter-success h2 {
      max-width: 17rem;
      font-size: 2rem;
      line-height: 1.3;
    }
    /* Tak skærm */
  }
</style>

<script>
  /* gemmer popup elementer i variabler */
  const popup = document.getElementById("newsletterPopup");
  const closeButton = document.querySelector(".newsletter-popup-close");
  const form = document.getElementById("newsletterForm");
  const signup = document.getElementById("newsletterSignup");
  const success = document.getElementById("newsletterSuccess");

  /* tjekker om popup allerede er vist */
  const popupHasBeenSeen = localStorage.getItem("newsletterPopupSeen");

  /* forsinkelse før popup vises */
  const popupDelay = 2200;

  /* viser popup hvis den ikke er set før */
  if (popupHasBeenSeen !== "true") {
    setTimeout(() => {
      popup?.classList.remove("is-hidden");
    }, popupDelay);
  }

  /* lukker popup og gemmer at den er set */
  closeButton?.addEventListener("click", () => {
    popup?.classList.add("is-hidden");
    localStorage.setItem("newsletterPopupSeen", "true");
  });

  /* viser tak skærm ved tilmelding */
  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    signup?.classList.add("is-hidden");
    success?.classList.add("is-visible");
    localStorage.setItem("newsletterPopupSeen", "true");
  });
</script>

