---

---

<section class="hero-wrapper">
  <!-- hero video -->
  <video class="hero-video" src="herovideo_bbw.mp4" autoplay muted loop playsinline></video>

  <!-- lydknap -->
  <button class="sound-toggle" type="button" aria-label="Slå lyd til" aria-pressed="false">
    <span class="sound-icon sound-icon-muted" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M10.5 5.5 6 9H3.5v6H6l4.5 3.5v-13Z"></path>
        <path d="M16.8 9.2l4.4 4.4"></path>
        <path d="M21.2 9.2l-4.4 4.4"></path>
      </svg>
    </span>

    <span class="sound-icon sound-icon-on" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M10.5 5.5 6 9H3.5v6H6l4.5 3.5v-13Z"></path>
        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
      </svg>
    </span>
  </button>

  <!-- hero tekst -->
  <div class="hero-text">
    <h1>busy being well</h1>
  </div>

  <!-- pilen på hero -->
  <button class="hero-arrow" type="button" aria-label="Scroll ned"></button>
</section>

<style>
  /* hero section */
  .hero-wrapper {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  /* hero video */
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* hero tekst */
  .hero-text {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: var(--cream);
  }

  /* overskrift i hero */
  .hero-text h1 {
    color: var(--cream);
    font-size: 2.9rem;
    font-weight: 150;
    margin: 0;
  }

  /* desktop/tablet styling */
  @media (min-width: 600px) {
    .hero-text h1 {
      font-size: clamp(3rem, 10vw, 6rem);
    }

    .hero-wrapper {
      position: relative;
      width: 100%;
      height: 100vh;
      overflow: hidden;
      margin-bottom: 0rem;
    }
  }

  /* lydknap */
  .sound-toggle {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    z-index: 20;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: none;
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    padding: 0;
  }

  /* lydikon */
  .sound-icon {
    width: 2rem;
    height: 2rem;
    display: block;
  }

  /* hover på lydknap */
  .sound-toggle:hover {
    color: var(--citat);
  }

  /* svg styling til lydikon */
  .sound-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* skjuler lyd-til ikon som standard */
  .sound-icon-on {
    display: none;
  }

  /* skjuler muted ikon når lyd er slået til */
  .sound-toggle.is-on .sound-icon-muted {
    display: none;
  }

  /* viser lyd-til ikon når lyd er slået til */
  .sound-toggle.is-on .sound-icon-on {
    display: block;
  }

  /* desktop placering af lydknap */
  @media (min-width: 600px) {
    .sound-toggle {
      right: 2rem;
      bottom: 1.8rem;
    }
  }

  /* pilen på hero */
  .hero-arrow {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    z-index: 20;
    width: 2.5rem;
    height: 2.5rem;
    transform: translateX(-50%);
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  /* selve pilens form */
  .hero-arrow::before {
    content: "";
    display: block;
    width: 1rem;
    height: 1rem;
    border-left: 0.18rem solid var(--white);
    border-bottom: 0.18rem solid var(--white);
    border-radius: 0.12rem;
    transform: rotate(-45deg);
  }

  /* hover på pil */
  .hero-arrow:hover::before {
    border-left-color: var(--citat);
    border-bottom-color: var(--citat);
  }

  /* desktop placering af pil */
  @media (min-width: 600px) {
    .hero-arrow {
      bottom: 2rem;
    }
  }
  /* pilen på hero */
</style>

<script>
  /* Gemmer video og knap i variabel */
  const video = document.querySelector(".hero-video");
  const soundButton = document.querySelector(".sound-toggle");

  /* lytter efter klik, før funktionen kører */
  if (video && soundButton) {
    soundButton.addEventListener("click", async () => {
      const shouldUnmute = video.muted;

      /* Tjekker om video er muted */
      video.muted = !shouldUnmute;
      video.volume = shouldUnmute ? 1 : 0;

      /* Skifter ikon og aria tekst */
      soundButton.classList.toggle("is-on", shouldUnmute);
      soundButton.setAttribute("aria-label", shouldUnmute ? "Slå lyd fra" : "Slå lyd til");
      soundButton.setAttribute("aria-pressed", String(shouldUnmute));

      /* Afspiller video igen hvis lyd slås til */
      if (shouldUnmute) {
        await video.play().catch(() => {});
      }
    });
  }

  /* pilen på hero */
  const heroArrow = document.querySelector(".hero-arrow");

  /* klik på pil scroller ned */
  if (heroArrow) {
    heroArrow.addEventListener("click", () => {
      window.scrollTo({
        top: window.innerHeight,
        behavior: "smooth",
      });
    });
  }
</script>
