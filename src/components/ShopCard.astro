---
const { data } = Astro.props;
---

<article class="shop-card">
  <img src={data.image_url} alt={`Billede af ${data.name}`} class="shop-image" loading="lazy" decoding="async" />

  <div class="shop-info">
    <div class="shop-row shop-row-top">
      <h2>{data.name}</h2>
      <p class="shop-price">{data.price} Kr.</p>
    </div>

    <div class="shop-row shop-row-bottom">
      <p class="shop-category">{data.category}</p>
      <a href={`/shop/${data.id}`}>Køb nu</a>
    </div>
  </div>
</article>

<style>
  .shop-card {
    color: var(--white);
  }

  .shop-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    display: block;
  }

  .shop-info {
    margin-top: 0.45rem;
  }

  .shop-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.5rem;
    align-items: start;
  }

  .shop-row-bottom {
    margin-top: 0.25rem;
    align-items: center;
  }

  .shop-card h2,
  .shop-card p,
  .shop-card a {
    font-family: "Unica", sans-serif;
    color: var(--white);
    margin: 0;
    padding: 0;
  }

  .shop-card h2 {
    font-family: "Playfair Display SC", serif;
    font-size: 1rem;
    line-height: 0.82;
    text-transform: uppercase;
    max-width: 7.5rem;
    font-weight: 520;
  }

  .shop-card p,
  .shop-card a {
    font-size: 1rem;
    line-height: 1.5;
  }

  .shop-price,
  .shop-card a {
    text-align: right;
    white-space: nowrap;
  }

  .shop-category {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .shop-category::before {
    content: "";
    flex: 0 0 auto;
    width: 0.3rem;
    height: 0.3rem;
    margin-right: 0.18rem;
    border-radius: 50%;
    background: var(--white);
  }

  .shop-card a {
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.08em;
  }

  @media (min-width: 600px) {
    .shop-info {
      margin-top: 0.7rem;
    }

    .shop-card h2 {
      font-size: 1.3rem;
      line-height: 0.82;
      max-width: 13rem;
    }

    .shop-card p,
    .shop-card a {
      font-size: 1rem;
    }

    .shop-category::before {
      width: 0.42rem;
      height: 0.42rem;
      margin-right: 0.2rem;
    }
  }
</style>
