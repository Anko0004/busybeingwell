---
const { data } = Astro.props;
---

<article class="shop-card">
  <img src={data.image_url} alt={`Billede af ${data.name}`} class="shop-image" loading="lazy" decoding="async" />

  <div class="shop-info">
    <div class="shop-row shop-row-top">
      <h2>{data.name}</h2>
      <p class="shop-price">{data.price} Kr.</p>
    </div>

    <div class="shop-row shop-row-bottom">
      <p class="shop-category">{data.category}</p>
      <a href={`/shop/${data.id}`} class="site-hover">LÆS MERE</a>
    </div>
  </div>
</article>

<style>
  .shop-card {
    color: var(--white);
    margin-bottom: 2rem;
    content-visibility: auto;
    contain-intrinsic-size: 0 22rem;
  }

  .shop-image {
    background: var(--test);
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    padding: 0.5rem;
  }

  .shop-info {
    padding-top: 0.5rem;
  }

  .shop-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.7rem;
    align-items: start;
  }

  .shop-row-bottom {
    margin-top: 0.25rem;
    align-items: center;
  }

  .shop-card h2,
  .shop-card p,
  .shop-card a {
    font-family: "Unica", sans-serif;
    color: var(--white);
    margin: 0;
    padding: 0;
  }

  .shop-card h2 {
    font-family: "Playfair Display SC", serif;
    text-transform: uppercase;
    font-size: 1.2rem;
    line-height: 1.15;
    margin-bottom: 0.1rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .shop-card p,
  .shop-card a {
    font-size: 1rem;
    line-height: 1.3rem;
  }

  .shop-price,
  .shop-card a {
    text-align: right;
    white-space: nowrap;
  }

  .shop-category {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shop-category::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    margin-right: 0.3rem;
    border-radius: 50%;
    background: var(--white);
  }

  .shop-card a {
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.08em;
  }

  /* hover effekt */
  .shop-card a.site-hover {
    transition: color 0.2s ease;
  }

  .shop-card a.site-hover:hover {
    color: var(--citat);
  }
  /* hover effekt */
</style>
