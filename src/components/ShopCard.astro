---
const { data } = Astro.props;
---

<article class="shop-card">
  <img src={data.image_url} alt={`Billede af ${data.name}`} class="shop-image" loading="lazy" decoding="async" />

  <div class="shop-info">
    <div class="shop-row">
      <h3>{data.name}</h3>
      <p>{data.price} Kr.</p>
    </div>

    <div class="shop-row">
      <p class="shop-category">{data.category}</p>
      <a href={`/shop/${data.id}`}>Køb nu</a>
    </div>
  </div>
</article>

<style>
  .shop-card {
    color: var(--white);
  }

  .shop-image {
    width: 100%;
    aspect-ratio: 4/ 5;
    object-fit: contain;
    display: block;
  }

  .shop-info {
    margin-top: 0.8rem;
  }

  .shop-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .shop-card h3,
  .shop-card p,
  .shop-card a {
    font-family: "Unica", sans-serif;
    color: var(--white);
    font-size: 0.9rem;
    line-height: 0.5rem;
    margin: 0;
  }

  .shop-card h3 {
    text-transform: uppercase;
  }

  .shop-category::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.2rem;
    border-radius: 50%;
    background: var(--white);
  }

  .shop-card a {
    text-transform: uppercase;
    text-decoration: underline;
    white-space: nowrap;
  }
</style>
