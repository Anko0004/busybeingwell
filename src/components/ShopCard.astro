---
const { data, index = 0 } = Astro.props;

const isVisible = index < 4;
const isHighPriority = index < 2;
---

<article class={`shop-card product-${data.id}`}>
  <a href={`/shop/${data.id}`} class="shop-image-link" aria-label={`Læs mere om ${data.name}`}>
    <img src={data.image_url} alt={`Billede af ${data.name}`} class="shop-image" loading="lazy" decoding="async" />
  </a>

  <div class="shop-info">
    <div class="shop-row shop-row-top">
      <h2>{data.name}</h2>
      <p class="shop-price">{data.price} Kr.</p>
    </div>

    <div class="shop-row shop-row-bottom">
      <p class="shop-category">{data.category}</p>
      <a href={`/shop/${data.id}`} class="site-hover">LÆS MERE</a>
    </div>
  </div>
</article>

<style>
  .shop-card {
    color: var(--white);
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .shop-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
  }

  /* Taske */
  .product-1 .shop-image {
    transform: scale(1.1);
  }

  /* T-shirt */
  .product-2 .shop-image {
    transform: scale(0.9);
  }

  /* Kasket */
  .product-3 .shop-image {
    transform: scale(0.9);
  }

  /* hoodie */
  .product-4 .shop-image {
    transform: scale(0.9);
  }

  .shop-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
  }

  .shop-image {
    transition: opacity 0.2s ease;
  }

  .shop-image-link:hover .shop-image {
    transition: color 0.2s ease;
  }

  .shop-info {
    padding-top: 0.5rem;
  }

  .shop-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.7rem;
    align-items: start;
  }

  .shop-row-bottom {
    margin-top: 0.5rem;
    align-items: center;
  }

  .shop-card h2,
  .shop-card p,
  .shop-card a {
    font-family: "Unica", sans-serif;
    color: var(--white);
    margin: 0;
    padding: 0;
  }

  .shop-card h2 {
    font-family: "Playfair Display SC", serif;
    text-transform: uppercase;
    font-size: 1rem;
    line-height: 1.15;
    margin-bottom: 0.1rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .shop-card p,
  .shop-card a {
    font-size: 0.85rem;
    line-height: 1.15rem;
  }

  .shop-price,
  .shop-card a {
    text-align: right;
    white-space: nowrap;
  }

  .shop-category {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 80%;
  }

  .shop-category::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    margin-right: 0.3rem;
    border-radius: 50%;
    background: var(--white);
  }

  .shop-card a {
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.08em;
  }

  /* hover effekt */
  .shop-card a.site-hover {
    transition: color 0.2s ease;
  }

  .shop-card a.site-hover:hover {
    color: var(--citat);
    position: relative;
    z-index: 2;
    transition: color 0.2s ease;
  }

  .shop-image {
    transition: opacity 0.2s ease;
  }

  .shop-image-link:hover .shop-image {
    filter: brightness(1.1);
  }

  /* hover effekt */

  @media (min-width: 900px) {
    .shop-card {
      margin-bottom: 2.5rem;
    }

    .shop-info {
      padding-top: 0.8rem;
    }

    .shop-card h2 {
      font-size: 1.15rem;
      line-height: 1.15;
    }

    .shop-card p,
    .shop-card a {
      font-size: 0.85rem;
      line-height: 1.25rem;
    }

    .shop-row-bottom {
      margin-top: 0.45rem;
    }

    /* Desktop: lidt mindre produktbilleder */
    .product-1 .shop-image {
      transform: scale(1.1);
    }

    .product-2 .shop-image {
      transform: scale(0.9);
    }

    .product-3 .shop-image {
      transform: scale(0.8);
    }

    .product-4 .shop-image {
      transform: scale(0.8);
    }
  }
</style>
