---
const { data, index = 0 } = Astro.props;

const isPriority = index < 3;
const isLarge = index % 7 === 0;

const date = new Date(data.release_date);
const formattedDate = date.toLocaleDateString("da-DK", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class="podcast-card">
  <img src={data.image_url} alt={`Billede af ${data.name}`} class="podcast-image" loading="lazy" decoding="async" sizes="(min-width: 900px) 25vw, 50vw" />

  <div class="podcast-content">
    <div class="podcast-meta">
      <span class="podcast-role">
        {data.role.length > 28 ? `${data.role.slice(0, 25)}...` : data.role}
      </span>
      <a href={`/podcasts/${data.id}`}>Læs mere</a>
    </div>

    <h2>{data.name}</h2>
    <p class="podcast-description">{data.description}</p>
  </div>
</article>

<style>
  .podcast-card {
    margin-bottom: 1rem;
  }

  .podcast-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .podcast-content {
    padding-top: 0.5rem;
  }

  .podcast-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .podcast-meta span,
  .podcast-meta a {
    font-family: "Unica", sans-serif;
    color: var(--black);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .podcast-meta a {
    text-decoration: underline;
    text-transform: uppercase;
  }

  .podcast-card h2 {
    font-size: 1.3rem;
    margin-top: 0.7rem;
    margin-bottom: 0.1rem;
  }

  .podcast-card p {
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.2rem;
  }

  .podcast-description {
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .podcast-role {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .podcast-role::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    border-radius: 50%;
    background: var(--black);
  }
</style>
