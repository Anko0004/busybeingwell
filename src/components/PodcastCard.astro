---
import Knap from "./Knap.astro";

const { data, index = 0, priority = false } = Astro.props;

const isPriority = priority;
const isLarge = index % 7 === 0;

const date = new Date(data.release_date);
const formattedDate = date.toLocaleDateString("da-DK", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const mobileRole = data.role.length > 18 ? `${data.role.slice(0, 15)}...` : data.role;
const desktopRole = data.role.length > 28 ? `${data.role.slice(0, 25)}...` : data.role;

const mobileName = data.name.length > 18 ? `${data.name.slice(0, 15)}...` : data.name;
const desktopName = data.name;
---

<article class="podcast-card">
  <a href={`/podcasts/${data.id}`} class="podcast-image-link" aria-label={`Læs mere om ${data.name}`}>
    <img src={data.image_url} alt={`Billede af ${data.name}`} class="podcast-image" loading={isPriority ? "eager" : "lazy"} decoding="async" fetchpriority={isPriority ? "high" : "auto"} sizes={isLarge ? "(min-width: 900px) 50vw, 100vw" : "(min-width: 900px) 25vw, 50vw"} />
  </a>

  <div class="podcast-content">
    <div class="podcast-meta">
      <span class="podcast-role">
        <span class="mobile-text">{mobileRole}</span>
        <span class="desktop-text">{desktopRole}</span>
      </span>
      <Knap text="LÆS MERE" href={`/podcasts/${data.id}`} variant="small" />
    </div>

    <h2>
      <span class="mobile-text">{mobileName}</span>
      <span class="desktop-text">{desktopName}</span>
    </h2>
    <p class="podcast-description">{data.description}</p>
  </div>
</article>

<style>
  .podcast-card {
    margin-bottom: 1rem;
  }

  .podcast-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .podcast-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
  }

  .podcast-image-link:hover .podcast-image {
    opacity: 0.85;
  }

  .podcast-content {
    padding-top: 0.5rem;
  }

  .podcast-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .podcast-meta span {
    font-family: "Unica", sans-serif;
    color: var(--black);
    font-size: 0.6rem;
    line-height: 1rem;
  }

  .podcast-card h2 {
    font-size: 1rem;
    margin-top: 0.7rem;
    margin-bottom: 0.1rem;
  }

  .podcast-card p {
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.2rem;
    margin-top: 0.25rem;
  }

  .podcast-description {
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .podcast-role {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .podcast-role::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 0.55rem;
    border-radius: 50%;
    background: var(--black);
  }

  .desktop-text {
    display: none;
  }

  .podcast-card .desktop-text {
    display: none;
  }

  @media (min-width: 500px) {
    .podcast-card .mobile-text {
      display: none;
    }

    .podcast-card .desktop-text {
      display: inline;
    }
  }

  /* Tekst størrelse desktop */
  @media (min-width: 900px) {
    .podcast-card h2 {
      font-size: 1.3rem;
      margin-top: 0.7rem;
      margin-bottom: 0.1rem;
    }

    .podcast-meta span {
      font-size: 0.75rem;
    }
  }
  /* Tekst størrelse desktop */

  /* hover effekt */
  .podcast-meta a.site-hover {
    transition: color 0.2s ease;
  }

  .podcast-meta a.site-hover:hover {
    color: var(--citat);
  }
  /* hover effekt */
</style>
